module SimpleCov
  module ExitCodes
    # Fails when any configured group falls below its minimum coverage
    # threshold for any criterion.
    class MinimumCoverageByGroupCheck < Check
      def exit_code: () -> untyped

      private

      def compute_violations: () -> untyped

      def violation_lines: (untyped violation) -> Array[String]
    end
  end
end
