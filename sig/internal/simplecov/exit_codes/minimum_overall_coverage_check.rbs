module SimpleCov
  module ExitCodes
    class MinimumOverallCoverageCheck < Check
      def exit_code: () -> untyped

      private

      WORST_FILES_LIMIT: 5

      def compute_violations: () -> untyped

      def violation_lines: (untyped violation) -> Array[String]

      def worst_files_lines: (untyped criterion) -> Array[String]

      def worst_files_for: (untyped criterion) -> untyped
    end
  end
end
