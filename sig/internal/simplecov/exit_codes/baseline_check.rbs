module SimpleCov
  module ExitCodes
    # Fails when a file listed in the checked-in baseline drops below
    # its own floor: a lower percent than the floor records AND more
    # misses than it allows (the dampener; a percent-only floor is
    # decided by the percent alone).
    class BaselineCheck < Check
      @baseline: Baseline?

      def initialize: (untyped result, Baseline? baseline) -> void

      def exit_code: () -> untyped

      private

      def compute_violations: () -> untyped

      def report_violation: (untyped violation) -> untyped

      def missed_clause: (untyped violation) -> String?
    end
  end
end
