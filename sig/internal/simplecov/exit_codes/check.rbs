module SimpleCov
  module ExitCodes
    # Shared skeleton for the threshold checks. Subclasses supply
    # `exit_code`, `compute_violations`, and `violation_lines`.
    class Check
      @result: untyped

      @thresholds: untyped

      @violations: untyped

      def initialize: (untyped result, untyped thresholds) -> void

      def failing?: () -> untyped

      # The structured violations this check found, as values.
      def violations: () -> untyped

      def report: () -> untyped

      # The whole report as values, one string per line.
      def report_lines: () -> Array[String]

      private

      attr_reader result: untyped

      attr_reader thresholds: untyped

      def compute_violations: () -> untyped

      def violation_lines: (untyped violation) -> Array[String]
    end
  end
end
