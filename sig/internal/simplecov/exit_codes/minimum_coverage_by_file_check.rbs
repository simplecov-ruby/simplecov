module SimpleCov
  module ExitCodes
    # Fails when any individual file falls below the configured minimum
    # coverage for any criterion.
    class MinimumCoverageByFileCheck < Check
      @overrides: untyped

      @baseline: Baseline?

      # `baseline:` exempts the file-and-criterion pairs it covers: those
      # answer to their own floor via `BaselineCheck` instead.
      def initialize: (untyped result, untyped minimum_coverage_by_file, ?::Hash[untyped, untyped] overrides, ?baseline: Baseline?) -> void

      def exit_code: () -> untyped

      private

      def compute_violations: () -> untyped

      def report_violation: (untyped violation) -> untyped
    end
  end
end
