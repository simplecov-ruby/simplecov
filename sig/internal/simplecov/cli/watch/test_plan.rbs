module SimpleCov
  module CLI
    module Watch
      module TestPlan
        def self?.no_global: () -> Hash[Symbol, Array[String]]

        def self?.build: (Array[String] changed, untyped document, root: String, input: String, stderr: untyped, ?global: Hash[Symbol, Array[String]]) -> Hash[Symbol, untyped]

        def self?.watched_paths: (untyped document, String root, ?Hash[Symbol, Array[String]] global) -> Array[String]



        def self?.recorded_test_files: (untyped document) -> Array[String]
      end
    end
  end
end
