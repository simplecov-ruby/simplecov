module SimpleCov
  module CLI
    module Serve
      module StaticFileHandler
        MIME: ::Hash[::String, ::String]

        STATUS_TEXT: ::Hash[::Integer, ::String]

        READ_TIMEOUT: ::Integer

        def self?.handle_connection: (untyped client, untyped root, ?Hash[String, untyped] routes) -> untyped

        def self?.dispatch: (untyped client, untyped method, untyped path, untyped root, Hash[String, untyped] routes) -> untyped

        def self?.serve_file: (untyped client, untyped path, untyped root) -> untyped

        def self?.drain_headers: (untyped client) -> untyped

        def self?.resolve: (untyped request_path, untyped root) -> untyped

        def self?.inside?: (untyped path, untyped root) -> untyped

        def self?.respond: (untyped client, untyped status, ?::String body, ?::String content_type) -> untyped
      end
    end
  end
end
