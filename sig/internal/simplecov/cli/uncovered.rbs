module SimpleCov
  module CLI
    # `simplecov uncovered [--threshold N] [--top N] [--criterion C]` — list
    # the lowest-coverage files (by the chosen criterion, ascending), so a
    # developer can answer "where should I add tests next?" without
    # opening a browser. Reads coverage.json directly.
    module Uncovered
      # `include` mirrors the runtime `extend` for steep's sake:
      # module_function bodies type-check on the instance side.
      include CommandHelpers

      extend CommandHelpers

      DEFAULT_TOP: 10

      def self?.run: (untyped args, stdout: untyped, stderr: untyped, **untyped) -> untyped

      def self?.report: (untyped opts, untyped keys, untyped stdout, untyped stderr) -> (1 | untyped | 0)

      def self?.unknown_criterion: (untyped criterion, untyped stderr) -> 1

      def self?.emit: (untyped stdout, untyped files, untyped opts) -> untyped

      def self?.parse: (untyped args) -> untyped

      # Option parsing with per-flag coercions is inherently ABC-heavy; the
      # metric is noise here.
      def self?.build_parser: (untyped opts) -> untyped

      # A negative count would raise from `Array#first`; report it as
      # the parse error it is.
      def self?.validate_top: (::Integer value) -> ::Integer

      def self?.emit_text: (untyped stdout, untyped files, untyped color) -> untyped

      def self?.emit_json: (untyped stdout, untyped files) -> untyped

      def self?.empty_message: (untyped json) -> ("[]" | "simplecov uncovered: nothing to report")

      def self?.rank: (untyped coverage_hash, untyped opts, untyped keys) -> untyped

      def self?.row_for: (untyped fname, untyped payload, untyped opts, untyped keys) -> (nil | ::Array[untyped])

      def self?.build_row: (untyped fname, untyped pct, untyped payload, untyped opts, untyped keys) -> ::Array[untyped]

      def self?.missed_for: (untyped payload, untyped criterion) -> ::Array[::Integer]

      def self?.collect_missed: (untyped items) -> ::Array[::Integer]

      def self?.format_row: (untyped fname, untyped pct, untyped covered, untyped total, untyped color) -> untyped
    end
  end
end
