module SimpleCov
  module CLI
    # `simplecov serve [--port N] [--host HOST]` — serve the coverage
    # report over HTTP. This module is the CLI wiring (options, binding,
    # the accept loop); the HTTP mechanics live in StaticFileHandler.
    module Serve
      # `include` mirrors the runtime `extend` for steep's sake:
      # module_function bodies type-check on the instance side.
      include CommandHelpers

      extend CommandHelpers

      def self?.run: (untyped args, stdout: untyped, stderr: untyped, **untyped) -> untyped

      def self?.parse: (untyped args) -> untyped

      def self?.announce: (untyped stdout, untyped server, untyped dir) -> untyped

      # Returns the block's exit status, or 1 when the socket can't
      # be bound.
      def self?.with_server: (untyped opts, untyped stderr) { (TCPServer) -> untyped } -> untyped

      def self?.serve_loop: (untyped server, untyped dir, untyped stdout) -> untyped

    end
  end
end
