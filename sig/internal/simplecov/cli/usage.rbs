module SimpleCov
  module CLI
    # The `simplecov help` text. A method so its default paths resolve at
    # call time against the active `.simplecov`.
    module Usage
      def self?.text: (untyped cli) -> ::String

      def self?.for: (untyped cli, String command) -> ::String

      def self?.section_for?: (String section, String command) -> bool

      def self?.heading_of: (String section) -> String
    end
  end
end
