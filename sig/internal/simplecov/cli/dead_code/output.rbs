module SimpleCov
  module CLI
    module DeadCode
      # Renders the crossed matrix: text views with `path:ranges` rows
      # and summary counts, and the JSON payload carrying every
      # category.
      module Output
        def self?.emit: (untyped stdout, untyped opts, Hash[Symbol, untyped] matrix, Hash[String, untyped] production) -> void

        def self?.emit_dead: (untyped stdout, Hash[Symbol, untyped] matrix) -> void

        def self?.emit_untested: (untyped stdout, Hash[Symbol, untyped] matrix) -> void

        def self?.section: (untyped stdout, String heading, Hash[Symbol, untyped] matrix, Symbol bucket) -> Integer

        def self?.count: (Hash[Symbol, untyped] matrix, Symbol bucket) -> Integer

        def self?.pluralize: (Integer number, String noun) -> String

        def self?.window_suffix: (Hash[String, untyped] production) -> String

        def self?.json_payload: (Hash[Symbol, untyped] matrix, Hash[String, untyped] production) -> Hash[Symbol, untyped]
      end
    end
  end
end
