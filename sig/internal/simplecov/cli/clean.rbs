module SimpleCov
  module CLI
    # `simplecov clean [--dry-run]` — remove the coverage report
    # directory (or whatever `SimpleCov.coverage_dir` resolves to). The
    # `--dry-run` flag prints what would be deleted without touching
    # disk, for when you're not sure what's in there.
    module Clean
      def self?.run: (untyped args, stdout: untyped, stderr: untyped, **untyped) -> (untyped | 0 | 1)

      def self?.sweep: (untyped dir, untyped opts, untyped stdout) -> untyped

      def self?.announce: (untyped stdout, untyped opts, untyped message) -> (untyped | nil)

      def self?.safe_to_remove?: (String dir) -> bool

      def self?.protected_paths: () -> Array[String]

      def self?.descendant_of?: (String path, String possible_ancestor) -> bool

      def self?.canonical_path: (String path) -> String

      def self?.parse: (untyped args) -> untyped
    end
  end
end
