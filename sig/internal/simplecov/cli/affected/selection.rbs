module SimpleCov
  module CLI
    module Affected
      module Selection
        TEST_FILE_NAME: Regexp

        def self?.build: (Array[String] changed, untyped document, Array[String] contexts, untyped opts, untyped stderr, root: String) -> Hash[Symbol, untyped]?

        def self?.reasons: (Hash[Symbol, untyped] state) -> Hash[String, Hash[String, Array[String]]]

        def self?.line_order: (String id) -> Integer

        def self?.select: (String file, String changed, String? id, Hash[Symbol, untyped] state) -> void

        def self?.initial_state: (Array[String] changed, Array[String] contexts, Hash[String, untyped] coverage, untyped opts, untyped stderr, root: String) -> Hash[Symbol, untyped]

        def self?.on_disk?: (String path, untyped state) -> bool

        def self?.entry_for: (String path, untyped state) -> untyped

        def self?.classify: (String path, untyped state) -> untyped



        def self?.note_untracked: (String path, Hash[Symbol, untyped] state) -> Array[String]

        def self?.select_test_file: (String path, untyped state, ?note_deleted: bool) -> String

        def self?.select_covering: (String path, untyped entry, untyped state) -> untyped

        def self?.select_unclaimed: (String path, Hash[String, untyped] entry, Integer mask, Hash[Integer, Integer] table, Hash[Symbol, untyped] state) -> untyped

        def self?.narrowed: (String path, Hash[String, untyped] entry, Hash[Symbol, untyped] state) -> Integer?

        def self?.read: (String path) -> String?

        def self?.base_source: (String path, String? merge_base, String root) -> String?

        def self?.covering_table: (String path, untyped entry, untyped state) -> untyped

        def self?.select_context: (String id, String path, untyped state) -> untyped

        def self?.test_file_of: (String id) -> String?
      end
    end
  end
end
