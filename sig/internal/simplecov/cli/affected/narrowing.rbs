module SimpleCov
  module CLI
    module Affected
      module Narrowing
        type side = [Integer, Integer, String]

        type edit = [side, side, side]

        type load_time = [Integer, Integer]

        HUNK: Regexp

        CODE: Regexp

        @prism: bool

        def self?.changes: (String recorded, String? base, String current) -> [Integer?, Array[load_time]]

        def self?.mask: (Array[edit] edits, Array[[Integer, Integer]] methods) -> Integer?

        def self?.load_time_lines: (edit edit, Array[[Integer, Integer]] methods, Array[[Integer, Integer]] statements, Array[Integer] silent, Array[Integer] enclosed) -> Array[load_time]

        def self?.statement_start: (Integer line, Array[[Integer, Integer]] methods, Array[[Integer, Integer]] statements) -> Integer?

        def self?.counterpart: (edit edit, Integer line) -> Integer

        def self?.first_code_line: (side side) -> Integer

        def self?.rewritten: (side side) -> Array[Integer]

        def self?.runs_at_load?: (String text) -> bool

        def self?.silent_lines: (String source, Array[Prism::Comment] comments) -> Array[Integer]

        def self?.enclosed_lines: (Array[Prism::Comment] comments) -> Array[Integer]

        def self?.hunks: (String? old_source, String new_source) -> Array[[side, side]]

        def self?.side: (Array[String] lines, untyped start, untyped count) -> side

        def self?.spot: (side side) -> [Integer, Integer]

        def self?.innermost: (Array[[Integer, Integer]] spans, [Integer, Integer] spot) -> [Integer, Integer]?

        def self?.body_mask: (Integer first, Integer last) -> Integer

        def self?.collect_spans: (Prism::node node, Array[[Integer, Integer]] methods, Array[[Integer, Integer]] statements) -> void

        def self?.diff: (String old_source, String new_source) -> String

        def self?.prism?: () -> bool
      end
    end
  end
end
