module SimpleCov
  module CLI
    module Watch
      include CommandHelpers

      extend CommandHelpers

      def self?.run: (untyped args, stdout: untyped, stderr: untyped, **untyped) -> Integer

      def self?.parse: (untyped args) -> [Hash[Symbol, untyped], Array[String]]

      def self?.bind: (untyped opts, untyped stderr) -> untyped

      def self?.serve_session: (untyped server, Array[String] command, untyped opts, untyped stdout, untyped stderr) -> Integer

      def self?.launch_browser: (untyped server, untyped stderr) -> untyped

      def self?.session_for: (Array[String] command, untyped opts, untyped stdout, untyped stderr) -> Session
    end
  end
end
