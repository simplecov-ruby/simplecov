module SimpleCov
  module CLI
    # `simplecov ratchet` — rewrite the checked-in per-file coverage
    # baseline from the current report, only ever tightening. `--init`
    # regenerates from scratch, `--dry-run` prints without writing,
    # `--json` emits the summary as data.
    module Ratchet
      # `include` mirrors the runtime `extend` for steep's sake:
      # module_function bodies type-check on the instance side.
      include CommandHelpers

      extend CommandHelpers

      def self?.run: (untyped args, stdout: untyped, stderr: untyped, **untyped) -> (0 | 1)

      def self?.parse: (untyped args, untyped stderr) -> (untyped | nil)

      def self?.current_floors: (untyped coverage) -> Baseline::current_floors

      def self?.usable?: (untyped percent, untyped missed) -> bool

      def self?.compute: (untyped opts, Baseline::current_floors current) -> [Baseline::Outcome, bool]

      def self?.emit: (untyped stdout, untyped opts, Baseline::Outcome outcome, bool generated) -> void

      def self?.change_summary: (Baseline::Outcome outcome, bool generated) -> String

      def self?.report_regressed: (untyped stdout, Array[String] regressed) -> void

      def self?.json_summary: (untyped opts, Baseline::Outcome outcome, bool generated) -> Hash[Symbol, untyped]
    end
  end
end
