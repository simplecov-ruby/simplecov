module SimpleCov
  class ResultAdapter
    @result: untyped

    attr_reader result: untyped

    def initialize: (untyped result) -> void

    def self.call: (*untyped) -> untyped

    def adapt: () -> (nil | untyped)

    private

    def adapt_one: (untyped file_name, untyped cover_statistic) -> ({ "lines" => untyped } | untyped)

    ADDRESS_PATTERN: ::Regexp

    ADDRESS_PLACEHOLDER: "0x0"

    SINGLETON_WRAPPER_PATTERN: ::Regexp

    def normalize_method_keys: (untyped cover_statistic) -> (nil | untyped)

    def normalize_method_key: (untyped key) -> untyped

    def class_display_name: (untyped klass) -> String

    def singleton_wrapper_name: (untyped klass) -> String?

    def aggregate_duplicated_branches: (untyped cover_statistic) -> (nil | untyped)

    def adapt_oneshot_lines_if_needed: (untyped file_name, untyped cover_statistic) -> (nil | untyped)

    def build_line_stub: (untyped file_name) -> untyped
  end
end
