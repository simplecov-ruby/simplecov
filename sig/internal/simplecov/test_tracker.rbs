module SimpleCov
  class TestTracker
    @delta: Delta
    @granularity: Symbol
    @defined_tests: ^() -> Array[[String, String]]
    @started: Hash[String, Set[String]]
    @segment: Segment?
    @lock: Mutex
    @owner: Thread?
    @depth: Integer
    @poisoned: bool

    self.@rspec_hook_installed: bool?
    self.@shared_rspec_locations: Hash[String, Integer]?
    self.@shared_minitest_sites: Hash[String?, Integer]?

    class Segment < ::Struct[untyped]
      attr_accessor id: String?
      attr_accessor opening: Hash[String, untyped]
      attr_accessor loading: bool

      def self.new: (String? id, Hash[String, untyped] opening, bool loading) -> Segment
    end

    attr_reader map: ContextMap

    def initialize: (?root_regex: Regexp, ?granularity: Symbol, ?defined_tests: ^() -> Array[[String, String]]) -> void

    def track: [T] (String test_id) { () -> T } -> T

    def test_file_loading: (String path) -> void

    def suite_starting: () -> void

    def test_file_starting: (String path) -> void

    def test_started: (String test_id, String name) -> void

    def poisoned?: () -> bool

    def dropped_reason: () -> String?

    def recorded_map: (?closing: Hash[String, untyped]?) -> ContextMap?

    def self.install_framework_hooks: () -> void

    def self.watch_test_file_loads: () -> TracePoint?

    def self.install_rspec_hook: (?untyped rspec) -> void

    def self.rspec_module: () -> untyped

    def self.reset_rspec_hook!: () -> void

    def self.install_minitest_hook: (?untyped test_case, ?untyped minitest) -> void

    def self.install_minitest_hook_when_loaded: (?Module root) -> void

    def self.watch_for_minitest_test: (untyped minitest) -> void

    def self.loaded_const: (Module mod, Symbol name) -> untyped

    def self.rspec_example_id: (untyped example) -> String

    def self.example_group_started: (untyped notification) -> void

    def self.example_started: (untyped notification) -> void

    def self.defined_tests: () -> Array[[String, String]]

    def self.rspec_defined_tests: (?untyped rspec) -> Array[[String, String]]

    def self.minitest_defined_tests: (?Module root) -> Array[[String, String]]

    def self.note_rspec_examples: (Array[untyped] examples) -> void

    def self.note_minitest_tests: (?Module root) -> void

    def self.repeated: [T] (Array[T] values) -> Hash[T, Integer]

    def self.minitest_tests: (Module root) -> Array[[untyped, Symbol]]

    def self.rspec_path: (String path, Hash[Symbol, untyped] metadata) -> String

    def self.minitest_test_id: (untyped test) -> String

    def self.minitest_id: (untyped test_case, String | Symbol name) -> String

    def self.minitest_name: (untyped test_case, String | Symbol name) -> String

    def self.minitest_site: (untyped test_case, String | Symbol name) -> String?

    def self.definition_site: (untyped test_case, String | Symbol name) -> Array[untyped]?

    module MinitestRun : ::Minitest::Test
      def run: () -> untyped
    end

    interface _SuiteRunner
      def run: (*untyped) -> untyped
    end

    module MinitestSuite : _SuiteRunner
      def run: (*untyped) -> untyped
    end

    module Accessors : Configuration
      @test_tracker: TestTracker?

      def track_test: [T] (String test_id) { () -> T } -> T

      def test_tracker: () -> TestTracker?

      def start_test_tracking: () -> void
    end

    private

    def begin_track: (String id) -> Hash[String, untyped]?

    def note_entry: () -> bool

    def settle: (String id, Hash[String, untyped]? entry) -> void

    def open_segment: (String? id, ?loading: bool) -> void

    def same_segment?: (String? id, bool loading) -> bool

    def open_outside_tests: (String? id, ?loading: bool) -> void

    def close_segment: (Hash[String, untyped] closing) -> void

    def flush_segment: (Hash[String, untyped]? closing) -> void

    def mark_partial_contexts: () -> void

    def ids_of: (String test_id) -> Array[String]

    def context_id: (String test_id) -> String

    def poison: () -> void
  end
end
