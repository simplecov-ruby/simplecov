module SimpleCov
  module ResultMerger
    # Reads and writes the persistent `.resultset.json` cache, including
    # file-lock synchronization between processes and atomic temp-file
    # renames so concurrent readers don't observe a truncated file.
    module ResultsetStore
      LOCK_MONITOR: Monitor

      def self?.resultset_path: () -> untyped

      def self?.writelock_path: () -> untyped

      def self?.write: (untyped resultset) -> untyped

      # Serialize threads before taking the process-wide file lock. Nested
      # calls by the owning thread bypass a second flock.
      def self?.synchronize: () { () -> untyped } -> untyped

      def self?.with_flock: () { () -> untyped } -> untyped
    end
  end
end
