module SimpleCov
  module ResultMerger
    # Read + parse a `.resultset.json` file with the same tolerance the
    # historical `ResultMerger` had: missing file returns `{}`, an empty
    # or unparseable file warns and returns `{}`, parse success returns
    # the decoded Hash.
    module ResultsetFile
      def self?.parse: (untyped path) -> untyped

      def self?.read: (untyped path) -> (nil | untyped)

      def self?.decode: (untyped content) -> untyped

      # Each surviving entry must be a Hash with a Numeric "timestamp"
      # and a Hash "coverage"; anything else is warned about and dropped.
      def self?.drop_malformed_entries: (Hash[untyped, untyped] resultset) -> Hash[untyped, untyped]

      def self?.well_formed_entry?: (untyped data) -> bool

      def self?.invalid_resultset: () -> Hash[untyped, untyped]
    end
  end
end
