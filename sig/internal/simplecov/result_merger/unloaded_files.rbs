module SimpleCov
  module ResultMerger
    module UnloadedFiles
      def self?.collector: (Set[String] into) -> ^(Hash[String, untyped] surviving) -> void

      def self?.carries?: (Hash[String, untyped] coverage, String criterion) -> bool

      CRITERION_PREDICATES: Hash[String, Symbol]

      def self?.tracked_in: (Hash[String, untyped] resultset) -> Set[String]

      def self?.carry_tracked: (Hash[String, untyped] entry, Hash[String, untyped] existing, Hash[String, untyped] incoming) -> Hash[String, untyped]

      def self?.inject: (Hash[String, untyped] coverage, _ToA[String] tracked_files) -> [Hash[String, untyped], Set[String]]

      def self?.never_executed: (Hash[String, untyped] coverage) -> Set[String]
    end
  end
end
