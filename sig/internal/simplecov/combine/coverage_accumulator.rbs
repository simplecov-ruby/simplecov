        module SimpleCov
  module Combine
    class CoverageAccumulator
      @files: Hash[String, untyped]?

      def self.executed?: (untyped lines) -> bool

      def self.file_executed?: (untyped coverage) -> bool

      def self.hit?: (untyped counts) -> bool?

      def self.arm_hit?: (untyped branches) -> bool

      def self.fold: (untyped pairs) -> [Array[String], untyped]

      @branch_coverage: bool
      @method_coverage: bool

      def initialize: () -> void

      def absorb: (untyped coverage) -> CoverageAccumulator

      def result: () -> untyped

      private def merge_file: (untyped existing, untyped file_coverage) -> untyped

      class MergedFile
        @branch_coverage: bool
        @method_coverage: bool
        @executed: bool
        @lines: Array[Integer?]?
        @branches: Hash[untyped, untyped]?
        @methods: Hash[untyped, untyped]?

        def initialize: (untyped coverage, branches: bool, methods: bool) -> void

        private def new_table: () -> Hash[untyped, untyped]

        def authoritative_table: (untyped combiner, untyped table, bool keep_empty) -> Hash[untyped, untyped]?

        def absorb: (untyped coverage) -> MergedFile

        def to_h: () -> Hash[String, untyped]

        private def reconcile_synthesized: (untyped coverage) -> void

        private def absorb_tuples: (untyped coverage) -> void

        private def replace_tuples: (untyped coverage) -> void

        private def drop_incoming_tuples: (untyped coverage) -> void

        private def lines_measured?: (Array[Integer?]? lines) -> bool
      end
    end
  end
        end
