module SimpleCov
  module Combine
    #
    # Combine different method coverage results on a single file.
    #
    # Should be called through `CoverageAccumulator`.
    module MethodsCombiner
      # Memoizes method identities. Declared in both contexts for the same
      # reason as `RubyDataParser`'s parse cache.
      self.@identities: Hash[untyped, Integer]?
      @identities: Hash[untyped, Integer]?

      #
      # Return merged methods or the existing methods if other is missing.
      #
      # Method coverage maps `[class, name, location]` keys to hit counts.
      # Keys are matched on their SOURCE identity (name, location),
      # ignoring the class element (issue #1234). Combining sums the hit
      # counts for matching methods and preserves methods that only
      # appear in one result.
      #
      # @return [Hash]
      #
      def self?.combine: (untyped coverage_a, untyped coverage_b) -> untyped

      # Folds `coverage` into `target`, an interned table keyed by method
      # source identity. A `nil` `target` stays `nil` until some resultset
      # actually carries methods.
      def self?.absorb: (untyped target, untyped coverage) -> untyped

      # Turns an interned table back into the tuple-keyed hash the rest of
      # SimpleCov reads.
      def self?.materialize: (untyped target) -> untyped

      def self?.merge_methods: (untyped target, untyped source) -> untyped

      def self?.identities: () -> Hash[untyped, Integer]

      def self?.source_identity: (untyped key) -> Array[untyped]
    end
  end
end
