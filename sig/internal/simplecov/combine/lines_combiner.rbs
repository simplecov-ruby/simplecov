module SimpleCov
  module Combine
    #
    # Combine two different lines coverage results on same file
    #
    # Should be called through `CoverageAccumulator`.
    module LinesCombiner
      # Folds `source` into `target` rather than building a third array.
      # Only for a `target` the caller owns outright; `source` is never
      # touched. nil + nil = nil, nil + int = int, int + int = sum.
      def self?.merge_into: (untyped target, untyped source) -> untyped

      # Split out only to keep `merge_into` short; it is the same loop.
      def self?.sum_into: (untyped target, untyped source, Integer size) -> untyped

      # The rare arm: existing is nil or malformed external input.
      def self?.coerce_add: (untyped existing, Integer value) -> Integer
    end
  end
end
