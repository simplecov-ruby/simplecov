module SimpleCov
  module StaticCoverageExtractor
    # Detects the `if` / `unless` / ternary conditions CRuby folds away
    # (compile-time literals), for which Coverage emits no branch.
    module ConditionFolding : ::Prism::Visitor
      # Prism node types for the literals that fold.
      STATIC_CONDITION_TYPES: Array[untyped]

      # The folding literals that are falsy (`false`, `nil`).
      FALSY_CONDITION_TYPES: Array[untyped]

      # The literals whose fold does not see through parentheses.
      PAREN_OPAQUE_TYPES: Array[untyped]

      # The scalar literals the compiler treats as fully static.
      STATIC_LITERAL_LEAF_TYPES: Array[untyped]

      # Non-literal reads eliminated when discarded, bare only.
      ELIMINABLE_READ_TYPES: Array[untyped]

      private

      def visit_folded_arms: (Symbol verdict, untyped truthy_arm, untyped falsy_arm) -> void

      def folded_condition: (untyped node) -> Symbol?

      def foldable?: (untyped node, untyped unwrapped) -> bool

      def unwrap_parentheses: (untyped node) -> untyped

      def eliminable_when_discarded?: (untyped node) -> bool

      def static_container_literal?: (untyped node) -> bool

      def static_container?: (untyped node) -> bool

      def static_array_literal?: (untyped node) -> bool

      def static_hash_literal?: (untyped node) -> bool

      def static_range_literal?: (untyped node) -> bool
    end
  end
end
