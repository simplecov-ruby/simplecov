module SimpleCov
  module StaticCoverageExtractor
    # The Prism 1.3 accessor renames for the trailing clause of
    # conditional nodes, resolved once at load.
    module PrismCompat
      # `Prism::IfNode#subsequent`, `consequent` before Prism 1.3.
      IF_NODE_SUBSEQUENT_METHOD: untyped

      # `else_clause` on UnlessNode / CaseNode / CaseMatchNode,
      # `consequent` before Prism 1.3.
      ELSE_CLAUSE_METHOD: untyped

      # The else/elsif clause of an if-like node, or the else clause of
      # anything else that has one.
      def self?.subsequent: (untyped node) -> untyped

      def self?.else_clause: (untyped node) -> untyped
    end
  end
end
