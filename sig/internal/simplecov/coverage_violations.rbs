module SimpleCov
  module CoverageViolations
    def self.minimum_overall: (untyped result, untyped thresholds) -> untyped

    def self.maximum_overall: (untyped result, untyped thresholds) -> untyped

    def self.minimum_by_file: (untyped result, untyped defaults, ?::Hash[untyped, untyped] overrides, ?baseline: Baseline?) -> untyped

    def self.baseline: (untyped result, Baseline? baseline) -> ::Array[::Hash[::Symbol, untyped]]

    def self.maximum_missed: (untyped result, untyped caps) -> ::Array[::Hash[::Symbol, untyped]]

    def self.maximum_missed_by_file: (untyped result, untyped defaults, ?::Hash[untyped, untyped] overrides, ?baseline: Baseline?) -> untyped

    def self.minimum_by_group: (untyped result, untyped thresholds) -> ::Array[::Hash[::Symbol, untyped]]

    def self.maximum_drop: (untyped result, untyped thresholds, ?last_run: untyped, ?mode: Symbol) -> (::Array[untyped] | untyped)

    private

    def self.percent_for: (untyped stats_source, untyped criterion) -> untyped

    def self.effective_per_file_thresholds: (untyped file, untyped defaults, untyped overrides) -> untyped

    def self.path_matches?: (untyped project_filename, untyped pattern) -> untyped

    def self.file_minimum_violation: (untyped file, untyped criterion, untyped expected) -> (nil | { criterion: untyped, expected: untyped, actual: untyped, filename: untyped, project_filename: untyped })

    def self.baseline_violation: (untyped file, untyped criterion, Baseline::Floor floor) -> (nil | ::Hash[::Symbol, untyped])

    def self.missed_for: (untyped stats_source, untyped criterion) -> Integer?

    def self.file_missed_cap_violation: (untyped file, untyped criterion, Integer maximum) -> (nil | ::Hash[::Symbol, untyped])

    def self.group_minimum_violations: (untyped group_name, untyped group, untyped minimums) -> ::Array[::Hash[::Symbol, untyped]]

    def self.lookup_group: (untyped result, untyped group_name) -> untyped

    def self.drop_baseline_percents: (Symbol mode, untyped last_run) -> (Hash[Symbol, untyped] | nil)

    def self.last_run_baseline: (untyped last_run) -> (Hash[Symbol, untyped] | nil)

    def self.median_baseline: () -> (Hash[Symbol, untyped] | nil)

    def self.history_totals: () -> Array[Hash[String, untyped]]

    def self.median: (Array[Numeric] values) -> Numeric

    def self.branch_baseline: () -> (Hash[Symbol, untyped] | nil)

    def self.branch_entry?: (untyped candidate, String branch) -> bool

    def self.compute_drop: (untyped criterion, untyped result, Hash[Symbol, untyped] baseline) -> (nil | untyped)

    def self.round: (untyped percent) -> untyped
  end
end
