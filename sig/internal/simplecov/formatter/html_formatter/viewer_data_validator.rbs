module SimpleCov
  module Formatter
    class HTMLFormatter
      module ViewerDataValidator
        META_STRINGS: Array[String]
        COVERAGE_FLAGS: Hash[String, String]
        STAT_FIELDS: Array[String]

        def self.call: (Hash[String, untyped] data) -> Hash[String, untyped]
        def self.validate_section!: (Hash[String, untyped] data, String key) -> void
        def self.validate_file!: (String filename, untyped file) -> void
        def self.validate_contexts!: (Hash[String, untyped] data) -> void
        def self.validate_production!: (Hash[String, untyped] data) -> void
        def self.validate_production_file!: (String filename, untyped entry) -> void
        def self.production_lines?: (untyped entry) -> bool
        def self.validate_context_table!: (String filename, untyped table, Integer count) -> void
        def self.context_entry?: (untyped key, untyped value, Integer count) -> bool
        def self.validate_meta!: (Hash[String, untyped] meta) -> void
        def self.validate_command_names!: (Hash[String, untyped] meta) -> void
        def self.validate_statistics!: (Hash[String, untyped] statistics, Hash[String, untyped] meta, String location) -> void
        def self.validate_group!: (String name, untyped group, Hash[String, untyped] meta) -> void
        def self.validate_type!: (Hash[String, untyped] object, String key, untyped type, String location) -> untyped
        def self.validate_boolean!: (Hash[String, untyped] meta, String key) -> void
      end
    end
  end
end
