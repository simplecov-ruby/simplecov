module SimpleCov
  module Formatter
    class JSONFormatter
      # Renders a single `SimpleCov::SourceFile` as the per-file payload
      # in coverage.json: source code plus per-enabled-criterion arrays
      # and totals.
      class SourceFileFormatter
        def self.call: (untyped source_file, ?include_source: bool, ?contexts: ContextMap?) -> untyped

        private

        def self.contexts_section: (untyped source_file, ContextMap contexts) -> Hash[Symbol, untyped]

        def self.format_source_code: (untyped source_file) -> { source: untyped }

        def self.line_coverage_section: (untyped source_file) -> { lines: untyped, lines_covered_percent: untyped, covered_lines: untyped, missed_lines: untyped, omitted_lines: untyped, total_lines: untyped }

        def self.branch_coverage_section: (untyped source_file) -> { branches: untyped, branches_covered_percent: untyped, covered_branches: untyped, missed_branches: untyped, total_branches: untyped }

        def self.method_coverage_section: (untyped source_file) -> { methods: untyped, methods_covered_percent: untyped, covered_methods: untyped, missed_methods: untyped, total_methods: untyped }

        def self.format_line: (untyped line) -> ("ignored" | untyped)

        def self.format_branch: (untyped branch) -> { type: untyped, start_line: untyped, end_line: untyped, coverage: untyped, inline: untyped, report_line: untyped }

        def self.format_method: (untyped method) -> { name: untyped, start_line: untyped, end_line: untyped, coverage: untyped }
      end
    end
  end
end
