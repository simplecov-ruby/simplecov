module SimpleCov
  self.@parallel_results_complete: untyped

  def self.final_result_process?: () -> untyped

  def self.wait_for_other_processes: () -> (nil | untyped)

  def self.parallel_results_complete?: () -> (untyped | true)

  PARALLEL_RESULTS_SETTLE: ::Float

  def self.wait_for_parallel_results: (untyped expected, ?native_wait: boolish) -> (true | false | untyped)

  def self.current_parallel_worker_count: () -> Integer

  def self.resultset_count_settled?: (untyped tracker, untyped count) -> (false | untyped)

  def self.monotonic_time: () -> untyped

  def self.parallel_wait_timed_out?: (untyped deadline, untyped expected, untyped seen) -> (false | true)

  def self.warn_about_incomplete_parallel_results: (untyped expected, untyped seen) -> (nil | untyped)
end
