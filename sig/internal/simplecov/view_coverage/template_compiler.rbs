module SimpleCov
  module ViewCoverage
    module TemplateCompiler
      def self?.available?: () -> bool

      def self?.call: (String path) -> bool

      def self?.compile_into_throwaway_module: (untyped template) -> void

      def self?.format_for: (String path) -> Symbol?

      def self?.build_template: (String path, String source) -> untyped
    end
  end
end
