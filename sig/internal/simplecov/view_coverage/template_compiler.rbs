module SimpleCov
  module ViewCoverage
    # Compiles a single ActionView template: builds a `Template` for the file
    # on disk and defines its method into a throwaway module, without ever
    # rendering it. Evaluating a `def` records the body as
    # executable-but-unexecuted, which is exactly the zeroed shape an
    # untested template should report.
    module TemplateCompiler
      # Whether this process can compile templates at all. False in any
      # project that doesn't load ActionView.
      def self?.available?: () -> bool

      # Compiles `path`, returning whether it produced coverage data. A
      # template that doesn't compile must not take the run down with it.
      def self?.call: (String path) -> bool

      # The format the template renders (`show.html.erb` is `:html`), taken
      # from the extension in front of the handler's.
      def self?.compile_into_throwaway_module: (untyped template) -> void

      def self?.format_for: (String path) -> Symbol?

      # The single place ActionView is named.
      def self?.build_template: (String path, String source) -> untyped
    end
  end
end
