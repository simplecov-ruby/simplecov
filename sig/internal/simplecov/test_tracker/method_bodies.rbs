module SimpleCov
  class TestTracker
    module MethodBodies
      EVERY_LINE: Integer

      extend MethodBodies

      def masks: (String path) -> [Integer, Integer]

      private

      def collect: (Prism::node node, [Integer, Integer] masks) -> [Integer, Integer]

      def add_method: (Prism::DefNode node, [Integer, Integer] masks) -> [Integer, Integer]

      def span: (Integer first, Integer? last) -> Integer
    end
  end
end
