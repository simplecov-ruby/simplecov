module SimpleCov
  class TestTracker
    class Delta
      ONE_BIT: Integer

      @root_regex: Regexp
      @in_root: Hash[String, bool]
      @method_masks: Hash[String, [Integer, Integer]]

      def initialize: (root_regex: Regexp) -> void

      def call: (Hash[String, untyped] before, Hash[String, untyped] after, ?loading: bool) -> Hash[String, Integer]

      private

      def own_lines: (String path, Integer bitmap, Array[Integer?] lines) -> Integer

      def method_masks: (String path) -> [Integer, Integer]

      def called: (Integer mask, Array[Integer?] lines) -> Integer

      def lines_in: (untyped file_coverage) -> Array[Integer?]?

      def line_delta: (Array[Integer?]? before_lines, Array[Integer?] after_lines) -> Integer

      def same_lines?: (Array[Integer?]? before_lines, Array[Integer?] after_lines) -> bool

      def grown_bitmap: (Array[Integer?] before_lines, Array[Integer?] after_lines) -> Integer
    end
  end
end
