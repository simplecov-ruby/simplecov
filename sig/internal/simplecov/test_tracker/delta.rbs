module SimpleCov
  class TestTracker
    class Delta
      @root_regex: Regexp
      @in_root: Hash[String, bool]

      def initialize: (root_regex: Regexp) -> void

      def call: (Hash[String, untyped] before, Hash[String, untyped] after) -> Hash[String, Integer]

      private

      def lines_in: (untyped file_coverage) -> Array[Integer?]?

      def line_delta: (Array[Integer?]? before_lines, Array[Integer?]? after_lines) -> Integer

      def grew?: (Integer? count, Integer? previous) -> bool
    end
  end
end
