module SimpleCov
  class ContextMap
    VERSION: Integer

    @contexts: Array[String]
    @indices: Hash[String, Integer]
    @files: Hash[String, Hash[Integer, Integer]]

    def record: (String context_id, Hash[String, Integer] lines_by_file) -> self

    def covering: (String path, Integer line) -> Array[String]

    def contexts: () -> Array[String]

    def empty?: () -> bool

    def absorb: (ContextMap other) -> self

    def to_h: (?only: Set[String]?) -> Hash[String, untyped]

    def serialized_bitmaps_for: (String path) -> Hash[String, String]

    def intern: (String context_id) -> Integer

    def self.from_hash: (untyped data) -> ContextMap?

    def self.build: (Array[String] contexts, Hash[untyped, untyped] files) -> ContextMap?

    def self.absorb_table: (ContextMap map, Array[String] contexts, String path, Hash[untyped, untyped] table) -> boolish

    def self.parse_index: (untyped index, Integer size) -> Integer?

    def self.parse_bitmap: (untyped encoded) -> Integer?

    def serialize_table: (Hash[Integer, Integer] table) -> Hash[String, String]

    def interned_contexts: () -> Array[String]

    def file_tables: () -> Hash[String, Hash[Integer, Integer]]
  end
end
