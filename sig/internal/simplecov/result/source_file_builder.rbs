module SimpleCov
  class Result
    class SourceFileBuilder
      @original_result: untyped

      @not_loaded_files: untyped

      @missing_source_files: untyped

      attr_reader missing_source_files: untyped

      def initialize: (untyped original_result, not_loaded_files: untyped) -> void

      def call: () -> untyped

      private

      def build_source_file: (untyped filename, untyped coverage) -> (nil | untyped)

      def stringify_outer_keys: (untyped coverage) -> untyped
    end
  end
end
