module SimpleCov
  class Result
    class MissingSourceFilesReporter
      @missing_paths: untyped

      @every_entry_dropped: untyped

      def initialize: (untyped missing_paths, every_entry_dropped: untyped) -> void

      def warn!: () -> untyped

      def message: () -> untyped

      private

      def all_missing_warning: () -> ::String

      def partial_missing_warning: () -> ::String

      def summary: () -> untyped
    end
  end
end
