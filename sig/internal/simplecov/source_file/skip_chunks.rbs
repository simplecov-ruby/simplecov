module SimpleCov
  class SourceFile
    # Computes the set of line ranges that should be excluded from a
    # SourceFile's coverage for each criterion, from the
    # `# simplecov:disable` / `# simplecov:enable` block directives, which
    # can be scoped per-criterion (`# simplecov:disable branch`, etc.) —
    # see `SimpleCov::Directive`.
    class SkipChunks
      @filename: untyped

      @src: untyped

      @directive_chunks: untyped

      def initialize: (untyped filename, untyped src) -> void

      # The per-criterion directive ranges, as 1-based line ranges.
      def for: (untyped criterion) -> untyped

      def directive_chunks: () -> untyped
    end
  end
end
