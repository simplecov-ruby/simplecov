module SimpleCov
  module ParallelResultMerger
    def self?.merge_and_store: (*untyped file_paths, processes: Integer, ?ignore_timeout: bool) -> untyped

    def self?.merge_results: (*untyped file_paths, processes: Integer, ?ignore_timeout: bool) -> untyped

    def self?.absorb_results: (Array[String] file_paths, processes: Integer, ?ignore_timeout: bool,
                               ?tracked_files: Set[String], ?context_maps: ContextMap::Union) -> untyped

    def self?.chunk: (Array[String] file_paths, Integer processes) -> Array[Array[String]]

    def self?.fan_out: (Array[Array[String]] chunks, ignore_timeout: bool, tracked_files: Set[String],
                        context_maps: ContextMap::Union) -> untyped

    def self?.spawn_workers: (Array[Array[String]] chunks, ignore_timeout: bool) -> Array[Hash[Symbol, untyped]]

    def self?.spawn_worker: (Array[String] chunk, ignore_timeout: bool) -> Hash[Symbol, untyped]

    def self?.abandon: (Array[Hash[Symbol, untyped]] workers) -> void

    def self?.drain: (Array[Hash[Symbol, untyped]] workers) -> Array[untyped]

    def self?.run_in_child: (IO reader, IO writer, Array[String] chunk, bool ignore_timeout) -> bot

    def self?.run_worker: (Array[String] chunk, IO writer, ignore_timeout: bool) -> Integer

    def self?.collect: (Array[Hash[Symbol, untyped]] workers) -> Array[untyped]?


    def self?.read_payload: (IO reader) -> untyped

    def self?.succeeded?: (Integer pid) -> bool

    def self?.warn_about_failed_workers: (Integer failed, Integer total) -> nil

  end
end
