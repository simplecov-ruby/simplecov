    def bucket_for: (Hash[Symbol, Floor] entry, Hash[Symbol, Floor] merged, Hash[Symbol, {percent: Numeric, missed: Integer}] current_entry) -> Symbol

    def tighten: (Floor? floor, {percent: Numeric, missed: Integer}? current) -> Floor

